                                </div>
                            </div>
                            <div class="contact-info-card">
                                <i class="fas fa-credit-card"></i>
                                <div>
                                    <strong data-i18n="index_payment">Medios de pago</strong>
                                    <p data-i18n="index_payment_val">Efectivo · Transferencia · Cheque · Tarjeta</p>
                                </div>
                            </div>
                            <div class="contact-info-card">
                                <i class="fas fa-truck"></i>
                                <div>
                                    <strong data-i18n="index_shipping">Despachos</strong>
                                    <p data-i18n="index_shipping_val">Envíos a todo el país · Retiro en local</p>
                                </div>
                            </div>
                            <div class="contact-info-card">
