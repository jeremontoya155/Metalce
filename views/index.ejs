                                        <% } %>
                                    </td>
                                    <td data-label="Nombre">
                                        <%= product.name %>
                                    </td>
                                    <td data-label="Descripción">
                                        <%
                                        // Función para limpiar solo caracteres problemáticos y normalizar acentos
                                        function cleanTextAdmin(text) {
                                          return text
                                            // Convertir caracteres de codificación problemáticos a 'a'
                                            .replace(/�/g, 'a')
                                            .replace(/Â/g, 'a')
                                            .replace(/â€™/g, "'")
                                            .replace(/â€œ/g, '"')
                                            .replace(/â€\u009d/g, '"')
                                            .replace(/€™/g, "'")
                                            
                                            // Correcciones específicas de palabras mal formadas
                                            .replace(/Resolucian/gi, 'Resolucion')
                                            .replace(/Resolucin/gi, 'Resolucion')
                                            
                                            // Diccionario de acentos: convertir á→a, é→e, etc.
                                            .replace(/á/g, 'a')
                                            .replace(/à/g, 'a')
                                            .replace(/â/g, 'a')
                                            .replace(/ä/g, 'a')
                                            .replace(/ã/g, 'a')
                                            .replace(/Á/g, 'A')
                                            .replace(/À/g, 'A')
                                            .replace(/Â/g, 'A')
                                            .replace(/Ä/g, 'A')
                                            .replace(/Ã/g, 'A')
                                            
                                            .replace(/é/g, 'e')
                                            .replace(/è/g, 'e')
                                            .replace(/ê/g, 'e')
                                            .replace(/ë/g, 'e')
                                            .replace(/É/g, 'E')
                                            .replace(/È/g, 'E')
                                            .replace(/Ê/g, 'E')
                                            .replace(/Ë/g, 'E')
                                            
                                            .replace(/í/g, 'i')
                                            .replace(/ì/g, 'i')
                                            .replace(/î/g, 'i')
                                            .replace(/ï/g, 'i')
                                            .replace(/Í/g, 'I')
                                            .replace(/Ì/g, 'I')
                                            .replace(/Î/g, 'I')
                                            .replace(/Ï/g, 'I')
                                            
                                            .replace(/ó/g, 'o')
                                            .replace(/ò/g, 'o')
                                            .replace(/ô/g, 'o')
                                            .replace(/ö/g, 'o')
                                            .replace(/õ/g, 'o')
                                            .replace(/Ó/g, 'O')
                                            .replace(/Ò/g, 'O')
                                            .replace(/Ô/g, 'O')
                                            .replace(/Ö/g, 'O')
                                            .replace(/Õ/g, 'O')
                                            
                                            .replace(/ú/g, 'u')
                                            .replace(/ù/g, 'u')
                                            .replace(/û/g, 'u')
                                            .replace(/ü/g, 'u')
                                            .replace(/Ú/g, 'U')
                                            .replace(/Ù/g, 'U')
                                            .replace(/Û/g, 'U')
                                            .replace(/Ü/g, 'U')
                                            
                                            // Casos especiales
                                            .replace(/ñ/g, 'n')
                                            .replace(/Ñ/g, 'N')
                                            .replace(/ç/g, 'c')
                                            .replace(/Ç/g, 'C')
                                            
                                            // Limpiar símbolos de pulgadas problemáticos
                                            .replace(/[��″"]/g, ' pulgadas')
                                            .replace(/pulgadas pulgadas/g, ' pulgadas')
                                            
                                            // Limpiar espacios múltiples
                                            .replace(/\s+/g, ' ')
                                            .trim();
                                        }
                                        %>
                                        <%= cleanTextAdmin(product.description) %>
                                    </td>
                                    <td data-label="Categoría">
                                        <% if (product.categoria_nombre) { %>
