<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        :root {
            --mc-bordeaux: #8B1538;
            --mc-bordeaux-dark: #5f0f28;
            --mc-bordeaux-soft: rgba(139, 21, 56, 0.1);
            --mc-ink: #18181b;
            --mc-muted: #6f6870;
            --mc-paper: #fffaf6;
            --mc-line: rgba(139, 21, 56, 0.14);
            --mc-success: #16784f;
            --mc-warning: #d99519;
            --mc-danger: #b42338;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 18% 12%, rgba(139, 21, 56, 0.12), transparent 28%),
                linear-gradient(135deg, #f7f2ee 0%, #ffffff 44%, #f3ece7 100%);
            color: var(--mc-ink);
        }

        .ofertas-page {
            max-width: 1240px;
        }

        .ofertas-hero {
            position: relative;
            overflow: hidden;
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
            gap: 28px;
            align-items: end;
            margin: 18px 0 24px;
            padding: clamp(28px, 4vw, 46px);
            border: 1px solid rgba(255, 255, 255, 0.42);
            border-radius: 30px;
            background:
                linear-gradient(135deg, rgba(24, 24, 27, 0.94), rgba(95, 15, 40, 0.92)),
                repeating-linear-gradient(45deg, rgba(255,255,255,0.06) 0 1px, transparent 1px 14px);
            color: #fff;
            box-shadow: 0 24px 70px rgba(95, 15, 40, 0.22);
        }

        .ofertas-hero::after {
            content: '';
            position: absolute;
            right: -90px;
            top: -110px;
            width: 320px;
            height: 320px;
            border: 42px solid rgba(255, 255, 255, 0.07);
            border-radius: 50%;
        }

        .ofertas-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
            padding: 8px 13px;
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            color: #ffe9ef;
            font-size: 0.76rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .ofertas-hero h1 {
            max-width: 760px;
            margin: 0 0 14px;
            font-size: clamp(2rem, 5vw, 4.15rem);
            font-weight: 900;
            letter-spacing: -0.055em;
            line-height: 0.96;
        }

        .ofertas-hero p {
            max-width: 680px;
            margin: 0;
            color: rgba(255, 255, 255, 0.76);
            font-size: 1.04rem;
            line-height: 1.65;
        }

        .ofertas-metrics {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .ofertas-metric {
            padding: 16px;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(8px);
        }

        .metric-number {
            display: block;
            font-size: 1.9rem;
            font-weight: 900;
            line-height: 1;
        }

        .metric-label {
            display: block;
            margin-top: 6px;
            color: rgba(255, 255, 255, 0.68);
            font-size: 0.74rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .ofertas-tabs {
            gap: 10px;
            border: 0;
            margin-bottom: 22px !important;
        }

        .ofertas-tabs .nav-item {
            margin-bottom: 0;
        }

        .ofertas-tabs .nav-link {
            border: 1px solid var(--mc-line);
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.74);
            color: var(--mc-bordeaux-dark);
            font-size: 0.87rem;
            font-weight: 800;
            letter-spacing: 0.01em;
            box-shadow: 0 8px 20px rgba(95, 15, 40, 0.06);
        }

        .ofertas-tabs .nav-link.active {
            border-color: transparent !important;
            background: linear-gradient(135deg, var(--mc-bordeaux), var(--mc-bordeaux-dark)) !important;
            color: white !important;
            box-shadow: 0 12px 26px rgba(139, 21, 56, 0.24);
        }

        .ofertas-container {
            overflow-x: auto;
            margin-bottom: 30px;
            padding: clamp(20px, 3vw, 32px);
            border: 1px solid var(--mc-line);
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 18px 55px rgba(95, 15, 40, 0.09);
        }

        .ofertas-container h2,
        .ofertas-container h3,
        .ofertas-container h4 {
            color: var(--mc-ink);
            font-weight: 900;
            letter-spacing: -0.03em;
        }

        .ofertas-container h2 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 8px;
        }

        .ofertas-container h2::before {
            content: '';
            display: inline-block;
            width: 9px;
            height: 34px;
            border-radius: 999px;
            background: linear-gradient(180deg, var(--mc-bordeaux), var(--mc-warning));
        }

        .text-muted {
            color: var(--mc-muted) !important;
        }
        
        .ofertas-table {
            width: 100%;
            min-width: 760px;
            margin-top: 20px;
            border-collapse: separate;
            border-spacing: 0;
            overflow: hidden;
            border: 1px solid rgba(139, 21, 56, 0.1);
            border-radius: 18px;
            background: white;
        }
        
        .ofertas-table th {
            padding: 14px 16px;
            background: linear-gradient(135deg, var(--mc-ink), var(--mc-bordeaux-dark));
            color: white;
            text-align: left;
            font-size: 0.73rem;
            font-weight: 900;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        
        .ofertas-table td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(139, 21, 56, 0.08);
            color: #2b292b;
            vertical-align: middle;
        }
        
        .ofertas-table tr:last-child td {
            border-bottom: 0;
        }

        .ofertas-table tbody tr:hover {
            background: #fff8f4;
        }
        
        .badge-oferta {
            display: inline-flex;
            align-items: center;
            padding: 6px 11px;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 900;
            letter-spacing: 0.06em;
        }
        
        .badge-activa {
            background: rgba(22, 120, 79, 0.12);
            color: var(--mc-success);
        }
        
        .badge-inactiva {
            background: rgba(180, 35, 56, 0.11);
            color: var(--mc-danger);
        }
        
        .badge-expirada {
            background: rgba(24, 24, 27, 0.1);
            color: var(--mc-ink);
        }
        
        .checkbox-producto {
            width: 20px;
            height: 20px;
            accent-color: var(--mc-bordeaux);
            cursor: pointer;
        }
        
        .btn-oferta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 8px 18px;
            border: none;
            border-radius: 999px;
            background: var(--mc-ink);
            color: white;
            cursor: pointer;
            font-weight: 800;
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }

        .btn-oferta:hover,
        .btn-oferta:focus {
            color: white;
            filter: brightness(1.04);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(24, 24, 27, 0.15);
        }
        
        .btn-crear {
            background: linear-gradient(135deg, var(--mc-bordeaux), var(--mc-bordeaux-dark));
            color: white;
            box-shadow: 0 12px 24px rgba(139, 21, 56, 0.22);
        }
        
        .btn-eliminar {
            background: var(--mc-danger);
            color: white;
            padding: 6px 14px;
            font-size: 0.82rem;
        }
        
        .form-oferta {
            margin-bottom: 30px;
            padding: clamp(18px, 2vw, 26px);
            border: 1px solid rgba(139, 21, 56, 0.1);
            border-radius: 20px;
            background:
                linear-gradient(135deg, rgba(255, 250, 246, 0.96), rgba(255, 255, 255, 0.96)),
                repeating-linear-gradient(45deg, rgba(139,21,56,0.045) 0 1px, transparent 1px 12px);
        }

        .form-oferta label,
        .modal label {
            color: #43202d;
            font-size: 0.84rem;
            letter-spacing: 0.01em;
        }

        .form-control {
            min-height: 42px;
            border-color: rgba(139, 21, 56, 0.16);
            border-radius: 12px;
            color: var(--mc-ink);
            box-shadow: none !important;
        }

        .form-control:focus {
            border-color: var(--mc-bordeaux);
            box-shadow: 0 0 0 0.18rem rgba(139, 21, 56, 0.12) !important;
        }
        
        .precio-info {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        
        .precio-original {
            color: var(--mc-muted);
            font-size: 0.9rem;
            text-decoration: line-through;
        }
        
        .precio-oferta {
            color: var(--mc-success);
            font-size: 1.16rem;
            font-weight: 900;
        }
        
        .descuento-tag {
            display: inline-flex;
            align-items: center;
            padding: 5px 9px;
            border-radius: 999px;
            background: rgba(217, 149, 25, 0.15);
            color: #8a5300;
            font-size: 0.76rem;
            font-weight: 900;
        }

        .seleccionar-todos {
            margin-bottom: 15px;
            padding: 10px 16px;
            border: 1px solid rgba(139, 21, 56, 0.14);
            border-radius: 999px;
            background: white;
            color: var(--mc-bordeaux-dark);
            cursor: pointer;
            font-weight: 900;
            box-shadow: 0 8px 18px rgba(95, 15, 40, 0.07);
        }

        .seleccionar-todos:hover {
            background: var(--mc-bordeaux-soft);
        }

        .contador-seleccionados {
            display: inline-flex;
            margin-bottom: 15px;
            padding: 10px 16px;
            border-radius: 999px;
            background: var(--mc-ink);
            color: white;
            font-weight: 900;
        }

        .cat-excluir-label:hover {
            border-color: var(--mc-danger) !important;
            background: #fff5f5 !important;
        }
        .cat-excluir-label:has(input:checked) {
            border-color: var(--mc-danger) !important;
            background: #ffe8e8 !important;
        }

        .modal-content {
            overflow: hidden;
            border: 0;
            border-radius: 22px;
            box-shadow: 0 24px 70px rgba(24, 24, 27, 0.22);
        }

        .modal-header {
            border-bottom: 0;
            background: linear-gradient(135deg, var(--mc-ink), var(--mc-bordeaux-dark)) !important;
        }

        .modal-footer {
            border-top: 1px solid rgba(139, 21, 56, 0.1);
            background: #fffaf6;
        }

        .btn-primary {
            border-color: var(--mc-bordeaux) !important;
            background: linear-gradient(135deg, var(--mc-bordeaux), var(--mc-bordeaux-dark)) !important;
            box-shadow: 0 10px 22px rgba(139, 21, 56, 0.2);
        }

        .btn-secondary {
            border-color: transparent !important;
            background: #ece5df !important;
            color: var(--mc-ink) !important;
            font-weight: 800;
        }

        .ofertas-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 36px;
            border: 0;
            border-radius: 999px;
            background: var(--mc-ink);
            color: #fff !important;
            font-weight: 800;
            text-decoration: none !important;
        }

        @media (max-width: 991px) {
            .ofertas-hero {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 576px) {
            .ofertas-hero {
                border-radius: 22px;
                padding: 24px 18px;
            }

            .ofertas-metrics {
                grid-template-columns: 1fr;
            }

            .ofertas-tabs {
                display: grid;
                grid-template-columns: 1fr;
            }

            .ofertas-tabs .nav-link {
                text-align: center;
            }

            .ofertas-container {
                border-radius: 18px;
            }
        }
    </style>
    <title>Gestión de Ofertas</title>
</head>
<body>
    <div class="container ofertas-page py-4">
        <%
            const totalProductosOferta = products ? products.length : 0;
            const totalActivas = ofertasActivas ? ofertasActivas.length : 0;
            const totalGenerales = ofertasGenerales ? ofertasGenerales.length : 0;
            const totalHistorial = todasOfertas ? todasOfertas.length : 0;
        %>
        <section class="ofertas-hero" aria-labelledby="ofertas-title">
            <div>
                <span class="ofertas-kicker">Metal-Ce Admin Comercial</span>
                <h1 id="ofertas-title">Campañas y descuentos con criterio comercial</h1>
                <p>Armá ofertas generales o por producto sin perder control sobre categorías, vigencia y precios finales. La pantalla ahora acompaña la identidad industrial del sitio.</p>
            </div>
            <div class="ofertas-metrics" aria-label="Resumen de ofertas">
                <div class="ofertas-metric">
                    <span class="metric-number"><%= totalActivas %></span>
                    <span class="metric-label">Ofertas activas</span>
                </div>
                <div class="ofertas-metric">
                    <span class="metric-number"><%= totalGenerales %></span>
                    <span class="metric-label">Generales</span>
                </div>
                <div class="ofertas-metric">
                    <span class="metric-number"><%= totalProductosOferta %></span>
                    <span class="metric-label">Productos</span>
                </div>
                <div class="ofertas-metric">
                    <span class="metric-number"><%= totalHistorial %></span>
                    <span class="metric-label">Historial</span>
                </div>
            </div>
        </section>

        <!-- Tabs -->
        <ul class="nav nav-tabs ofertas-tabs mb-4" id="ofertasTabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="general-tab" data-toggle="tab" href="#general" role="tab">
                    Oferta general
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="crear-tab" data-toggle="tab" href="#crear" role="tab">
                    Ofertas por producto
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="activas-tab" data-toggle="tab" href="#activas" role="tab">
                    Ofertas Activas
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="historial-tab" data-toggle="tab" href="#historial" role="tab">
                    Historial
                </a>
            </li>
        </ul>

        <div class="tab-content" id="ofertasTabContent">
            <!-- TAB: Oferta General -->
            <div class="tab-pane fade show active" id="general" role="tabpanel">
                <div class="ofertas-container">
                    <h2>Oferta general para el catálogo</h2>
                    <p class="text-muted">Aplicá una campaña transversal y excluí categorías sensibles para sostener margen. Si un producto tiene oferta específica, esa prioridad se respeta.</p>
                    
                    <form action="/admin/ofertas/general/crear" method="POST" class="form-oferta">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="nombre_general"><strong>Nombre de la Campaña</strong></label>
                                    <input type="text" class="form-control" id="nombre_general" name="nombre" placeholder="Ej: 15% en Efectivo" required>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="descripcion_general"><strong>Descripción</strong></label>
                                    <input type="text" class="form-control" id="descripcion_general" name="descripcion" placeholder="Descripción opcional">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="tipo_descuento_general"><strong>Tipo de Descuento</strong></label>
                                    <select class="form-control" id="tipo_descuento_general" name="tipo_descuento" required>
                                        <option value="porcentaje">Porcentaje (%)</option>
                                        <option value="monto_fijo">Monto Fijo ($)</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="valor_descuento_general"><strong>Valor del Descuento</strong></label>
                                    <input type="number" step="0.01" min="0.01" class="form-control" id="valor_descuento_general" name="valor_descuento" placeholder="Ej: 15" required>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="fecha_inicio_general"><strong>Fecha y Hora de Inicio</strong></label>
                                    <input type="datetime-local" class="form-control" id="fecha_inicio_general" name="fecha_inicio" required>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="fecha_fin_general"><strong>Fecha y Hora de Fin</strong></label>
                                    <input type="datetime-local" class="form-control" id="fecha_fin_general" name="fecha_fin" required>
                                </div>
                            </div>
                        </div>

                        <!-- Categorías excluidas -->
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label><strong>Excluir categorías de esta oferta</strong></label>
                                    <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 8px;">Marcá las categorías que <strong>NO</strong> deben tener esta oferta.</p>
                                    <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                                        <% if (categorias && categorias.length > 0) { %>
                                            <% categorias.forEach(cat => { %>
                                                <label style="display: flex; align-items: center; gap: 6px; padding: 6px 14px; background: #f8f9fa; border: 2px solid #dee2e6; border-radius: 8px; cursor: pointer; transition: all 0.2s; font-size: 0.9rem;" class="cat-excluir-label">
                                                    <input type="checkbox" name="categorias_excluidas" value="<%= cat.id %>" style="width: 16px; height: 16px;">
                                                    <span><%= cat.icono || '📦' %> <%= cat.nombre %></span>
                                                </label>
                                            <% }); %>
                                        <% } else { %>
                                            <span class="text-muted">No hay categorías creadas</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn-oferta btn-crear mt-3">
                            Crear oferta general
                        </button>
                    </form>

                    <hr class="my-4">

                    <h3>Campañas generales existentes</h3>
                    <table class="ofertas-table mt-3">
                        <thead>
                            <tr>
                                <th>Campaña</th>
                                <th>Descuento</th>
                                <th>Excluidas</th>
                                <th>Vigencia</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (ofertasGenerales && ofertasGenerales.length > 0) { %>
                                <% ofertasGenerales.forEach(oferta => { 
                                    const excluidas = oferta.categorias_excluidas ? oferta.categorias_excluidas.split(',').filter(x => x) : [];
                                    const categoriasExcluidasNames = excluidas.map(cid => {
                                        const cat = categorias.find(c => c.id == cid);
                                        return cat ? (cat.icono || '📦') + ' ' + cat.nombre : '';
                                    }).filter(n => n);
                                %>
                                    <tr>
                                        <td>
                                            <strong><%= oferta.nombre %></strong>
                                            <% if (oferta.descripcion) { %>
                                                <br><small class="text-muted"><%= oferta.descripcion %></small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (oferta.tipo_descuento === 'porcentaje') { %>
                                                <span class="descuento-tag"><%= oferta.valor_descuento %>%</span>
                                            <% } else { %>
                                                <span class="descuento-tag">$<%= oferta.valor_descuento %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (categoriasExcluidasNames.length > 0) { %>
                                                <% categoriasExcluidasNames.forEach(name => { %>
                                                    <span style="display: inline-block; background: #fff3cd; color: #856404; padding: 2px 8px; border-radius: 10px; font-size: 0.75rem; margin: 2px;"><%= name %></span>
                                                <% }); %>
                                            <% } else { %>
                                                <small class="text-muted">Ninguna</small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <small>
                                                <%= new Date(oferta.fecha_inicio).toLocaleDateString('es-ES') %><br>
                                                hasta<br>
                                                <%= new Date(oferta.fecha_fin).toLocaleDateString('es-ES') %>
                                            </small>
                                        </td>
                                        <td>
                                            <% if (oferta.activo) { %>
                                                <span class="badge-oferta badge-activa">ACTIVA</span>
                                            <% } else { %>
                                                <span class="badge-oferta badge-inactiva">INACTIVA</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <button type="button" class="btn-oferta" style="background: #18181b; color: white; padding: 5px 15px; font-size: 0.85rem; margin-bottom: 4px;" onclick="editarOfertaGeneral(<%= oferta.id %>, '<%= oferta.nombre %>', '<%= oferta.descripcion || '' %>', '<%= oferta.tipo_descuento %>', <%= oferta.valor_descuento %>, '<%= new Date(oferta.fecha_inicio).toISOString().slice(0,16) %>', '<%= new Date(oferta.fecha_fin).toISOString().slice(0,16) %>', '<%= oferta.categorias_excluidas || '' %>')">
                                                 Editar
                                            </button>
                                            <form action="/admin/ofertas/general/toggle/<%= oferta.id %>" method="POST" style="display: inline; margin-right: 5px;">
                                                <% if (oferta.activo) { %>
                                                     <button type="submit" class="btn-oferta" style="background: #d99519; color: #18181b; padding: 5px 15px; font-size: 0.85rem;">Pausar</button>
                                                <% } else { %>
                                                     <button type="submit" class="btn-oferta" style="background: #16784f; color: white; padding: 5px 15px; font-size: 0.85rem;">Activar</button>
                                                <% } %>
                                            </form>
                                            <form action="/admin/ofertas/general/eliminar/<%= oferta.id %>" method="POST" style="display: inline;" onsubmit="return confirm('¿Eliminar esta oferta general?')">
                                                 <button type="submit" class="btn-oferta btn-eliminar">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center">No hay ofertas generales creadas</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB: Crear Ofertas -->
            <div class="tab-pane fade" id="crear" role="tabpanel">
                <div class="ofertas-container">
                    <h2>Oferta específica por producto</h2>
                    <p class="text-muted">Elegí piezas puntuales del catálogo para activar descuentos quirúrgicos, ideales para stock, temporada o acuerdos comerciales.</p>
                    
                    <form action="/admin/ofertas/crear" method="POST" id="formOfertas" class="form-oferta">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="tipo_descuento"><strong>Tipo de Descuento</strong></label>
                                    <select class="form-control" id="tipo_descuento" name="tipo_descuento" required>
                                        <option value="porcentaje">Porcentaje (%)</option>
                                        <option value="monto_fijo">Monto Fijo ($)</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="valor_descuento"><strong>Valor del Descuento</strong></label>
                                    <input type="number" step="0.01" min="0.01" class="form-control" id="valor_descuento" name="valor_descuento" placeholder="Ej: 20 o 50.00" required>
                                    <small class="form-text text-muted">Para porcentaje: 0-100. Para monto: cantidad en $</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="fecha_inicio"><strong>Fecha y Hora de Inicio</strong></label>
                                    <input type="datetime-local" class="form-control" id="fecha_inicio" name="fecha_inicio" required>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="fecha_fin"><strong>Fecha y Hora de Fin</strong></label>
                                    <input type="datetime-local" class="form-control" id="fecha_fin" name="fecha_fin" required>
                                </div>
                            </div>
                        </div>

                        <div class="contador-seleccionados" id="contador">
                            Productos seleccionados: <span id="count">0</span>
                        </div>

                        <button type="button" class="seleccionar-todos" onclick="toggleTodos()">
                            Seleccionar o deseleccionar todos
                        </button>

                        <h4 class="mt-4 mb-3">Productos alcanzados por la oferta</h4>
                        
                        <table class="ofertas-table">
                            <thead>
                                <tr>
                                    <th width="50">
                                        <input type="checkbox" id="selectAll" class="checkbox-producto">
                                    </th>
                                    <th>Producto</th>
                                    <th>Precio Actual</th>
                                    <th>Stock</th>
                                    <th>Vista Previa</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (products && products.length > 0) { %>
                                    <% products.forEach(product => { %>
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="productos[]" value="<%= product.id %>" class="checkbox-producto check-producto" data-precio="<%= product.price %>">
                                            </td>
                                            <td><strong><%= product.name %></strong></td>
                                            <td>$<%= product.price %></td>
                                            <td><%= product.stock %></td>
                                            <td>
                                                <span class="precio-preview" data-id="<%= product.id %>" data-precio="<%= product.price %>">
                                                    -
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center">No hay productos disponibles</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>

                        <button type="submit" class="btn-oferta btn-crear mt-4">
                            Crear oferta para productos seleccionados
                        </button>
                    </form>
                </div>
            </div>

            <!-- TAB: Ofertas Activas -->
            <div class="tab-pane fade" id="activas" role="tabpanel">
                <div class="ofertas-container">
                    <h2>Ofertas activas en este momento</h2>
                    
                    <table class="ofertas-table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Descuento</th>
                                <th>Precio Original</th>
                                <th>Precio Oferta</th>
                                <th>Vigencia</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (ofertasActivas && ofertasActivas.length > 0) { %>
                                <% ofertasActivas.forEach(oferta => { %>
                                    <tr>
                                        <td><strong><%= oferta.product_name %></strong></td>
                                        <td>
                                            <% if (oferta.tipo_descuento === 'porcentaje') { %>
                                                <span class="descuento-tag"><%= oferta.valor_descuento %>% OFF</span>
                                            <% } else { %>
                                                <span class="descuento-tag">-$<%= oferta.valor_descuento %></span>
                                            <% } %>
                                        </td>
                                        <td class="precio-original">$<%= oferta.precio_original %></td>
                                        <td class="precio-oferta">$<%= oferta.precio_final %></td>
                                        <td>
                                            <small>
                                                <%= new Date(oferta.fecha_inicio).toLocaleDateString('es-ES') %><br>
                                                hasta<br>
                                                <%= new Date(oferta.fecha_fin).toLocaleDateString('es-ES') %>
                                            </small>
                                        </td>
                                        <td>
                                            <% if (oferta.activo) { %>
                                                <span class="badge-oferta badge-activa">ACTIVA</span>
                                            <% } else { %>
                                                <span class="badge-oferta badge-inactiva">INACTIVA</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <button type="button" class="btn-oferta" style="background: #18181b; color: white; padding: 5px 15px; font-size: 0.85rem; margin-bottom: 4px;" onclick="editarOfertaEspecifica(<%= oferta.id %>, '<%= oferta.tipo_descuento %>', <%= oferta.valor_descuento %>, '<%= new Date(oferta.fecha_inicio).toISOString().slice(0,16) %>', '<%= new Date(oferta.fecha_fin).toISOString().slice(0,16) %>')">
                                                 Editar
                                            </button>
                                            <form action="/admin/ofertas/toggle/<%= oferta.id %>" method="POST" style="display: inline; margin-right: 5px;">
                                                <% if (oferta.activo) { %>
                                                     <button type="submit" class="btn-oferta" style="background: #d99519; color: #18181b; padding: 5px 15px; font-size: 0.85rem;">Pausar</button>
                                                <% } else { %>
                                                     <button type="submit" class="btn-oferta" style="background: #16784f; color: white; padding: 5px 15px; font-size: 0.85rem;">Activar</button>
                                                <% } %>
                                            </form>
                                            <form action="/admin/ofertas/eliminar/<%= oferta.id %>" method="POST" style="display: inline;" onsubmit="return confirm('¿Eliminar esta oferta?')">
                                                 <button type="submit" class="btn-oferta btn-eliminar">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center">No hay ofertas activas</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB: Historial -->
            <div class="tab-pane fade" id="historial" role="tabpanel">
                <div class="ofertas-container">
                    <h2>Historial de campañas</h2>
                    
                    <table class="ofertas-table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Descuento</th>
                                <th>Vigencia</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (todasOfertas && todasOfertas.length > 0) { %>
                                <% todasOfertas.forEach(oferta => { %>
                                    <tr>
                                        <td><strong><%= oferta.product_name %></strong></td>
                                        <td>
                                            <% if (oferta.tipo_descuento === 'porcentaje') { %>
                                                <%= oferta.valor_descuento %>%
                                            <% } else { %>
                                                $<%= oferta.valor_descuento %>
                                            <% } %>
                                        </td>
                                        <td>
                                            <small>
                                                <%= new Date(oferta.fecha_inicio).toLocaleDateString('es-ES') %> - 
                                                <%= new Date(oferta.fecha_fin).toLocaleDateString('es-ES') %>
                                            </small>
                                        </td>
                                        <td>
                                            <% if (oferta.activo) { %>
                                                <span class="badge-oferta badge-activa">ACTIVA</span>
                                            <% } else { %>
                                                <span class="badge-oferta badge-inactiva">INACTIVA</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <button type="button" class="btn-oferta" style="background: #18181b; color: white; padding: 5px 15px; font-size: 0.85rem; margin-bottom: 4px;" onclick="editarOfertaEspecifica(<%= oferta.id %>, '<%= oferta.tipo_descuento %>', <%= oferta.valor_descuento %>, '<%= new Date(oferta.fecha_inicio).toISOString().slice(0,16) %>', '<%= new Date(oferta.fecha_fin).toISOString().slice(0,16) %>')">
                                                 Editar
                                            </button>
                                            <form action="/admin/ofertas/toggle/<%= oferta.id %>" method="POST" style="display: inline; margin-right: 5px;">
                                                <% if (oferta.activo) { %>
                                                     <button type="submit" class="btn-oferta" style="background: #d99519; color: #18181b; padding: 5px 15px; font-size: 0.85rem;">Pausar</button>
                                                <% } else { %>
                                                     <button type="submit" class="btn-oferta" style="background: #16784f; color: white; padding: 5px 15px; font-size: 0.85rem;">Activar</button>
                                                <% } %>
                                            </form>
                                            <form action="/admin/ofertas/eliminar/<%= oferta.id %>" method="POST" style="display: inline;" onsubmit="return confirm('¿Eliminar esta oferta?')">
                                                 <button type="submit" class="btn-oferta btn-eliminar">Eliminar</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center">No hay historial de ofertas</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a href="/" class="btn ofertas-back">Volver al Admin</a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>

    <!-- Modal Editar Oferta Específica -->
    <div class="modal fade" id="editOfertaEspecificaModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header" style="background: #18181b; color: white;">
                    <h5 class="modal-title">Editar oferta específica</h5>
                    <button type="button" class="close" data-dismiss="modal" style="color: white;">
                        <span>&times;</span>
                    </button>
                </div>
                <form id="formEditarEspecifica" method="POST">
                    <div class="modal-body">
                        <div class="form-group">
                            <label><strong>Tipo de Descuento</strong></label>
                            <select class="form-control" id="edit_esp_tipo" name="tipo_descuento" required>
                                <option value="porcentaje">Porcentaje (%)</option>
                                <option value="monto_fijo">Monto Fijo ($)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label><strong>Valor del Descuento</strong></label>
                            <input type="number" step="0.01" min="0.01" class="form-control" id="edit_esp_valor" name="valor_descuento" required>
                        </div>
                        <div class="form-group">
                            <label><strong>Fecha y Hora de Inicio</strong></label>
                            <input type="datetime-local" class="form-control" id="edit_esp_inicio" name="fecha_inicio" required>
                        </div>
                        <div class="form-group">
                            <label><strong>Fecha y Hora de Fin</strong></label>
                            <input type="datetime-local" class="form-control" id="edit_esp_fin" name="fecha_fin" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Editar Oferta General -->
    <div class="modal fade" id="editOfertaGeneralModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header" style="background: #18181b; color: white;">
                    <h5 class="modal-title">Editar oferta general</h5>
                    <button type="button" class="close" data-dismiss="modal" style="color: white;">
                        <span>&times;</span>
                    </button>
                </div>
                <form id="formEditarGeneral" method="POST">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label><strong>Nombre de la Campaña</strong></label>
                                    <input type="text" class="form-control" id="edit_gen_nombre" name="nombre" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label><strong>Descripción</strong></label>
                                    <input type="text" class="form-control" id="edit_gen_descripcion" name="descripcion">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label><strong>Tipo de Descuento</strong></label>
                                    <select class="form-control" id="edit_gen_tipo" name="tipo_descuento" required>
                                        <option value="porcentaje">Porcentaje (%)</option>
                                        <option value="monto_fijo">Monto Fijo ($)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label><strong>Valor del Descuento</strong></label>
                                    <input type="number" step="0.01" min="0.01" class="form-control" id="edit_gen_valor" name="valor_descuento" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label><strong>Fecha y Hora de Inicio</strong></label>
                                    <input type="datetime-local" class="form-control" id="edit_gen_inicio" name="fecha_inicio" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label><strong>Fecha y Hora de Fin</strong></label>
                                    <input type="datetime-local" class="form-control" id="edit_gen_fin" name="fecha_fin" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label><strong>Excluir categorías</strong></label>
                            <div style="display: flex; flex-wrap: wrap; gap: 10px;" id="edit_gen_categorias_container">
                                <% if (categorias && categorias.length > 0) { %>
                                    <% categorias.forEach(cat => { %>
                                        <label style="display: flex; align-items: center; gap: 6px; padding: 6px 14px; background: #f8f9fa; border: 2px solid #dee2e6; border-radius: 8px; cursor: pointer; transition: all 0.2s; font-size: 0.9rem;" class="cat-excluir-label">
                                            <input type="checkbox" name="categorias_excluidas" value="<%= cat.id %>" class="edit-gen-cat-check" style="width: 16px; height: 16px;">
                                            <span><%= cat.icono || '📦' %> <%= cat.nombre %></span>
                                        </label>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script>
        // Actualizar contador de productos seleccionados
        function actualizarContador() {
            const checkboxes = document.querySelectorAll('.check-producto:checked');
            document.getElementById('count').textContent = checkboxes.length;
        }

        // Calcular precio de oferta en tiempo real
        function calcularPrecioOferta(precioOriginal, tipoDescuento, valorDescuento) {
            if (tipoDescuento === 'porcentaje') {
                return (precioOriginal * (1 - valorDescuento / 100)).toFixed(2);
            } else {
                return Math.max(precioOriginal - valorDescuento, 0).toFixed(2);
            }
        }

        // Actualizar vista previa de precios
        function actualizarVistasPrevia() {
            const tipoDescuento = document.getElementById('tipo_descuento').value;
            const valorDescuento = parseFloat(document.getElementById('valor_descuento').value) || 0;
            
            document.querySelectorAll('.check-producto:checked').forEach(checkbox => {
                const precioOriginal = parseFloat(checkbox.dataset.precio);
                const productId = checkbox.value;
                const spanPreview = document.querySelector(`.precio-preview[data-id="${productId}"]`);
                
                if (valorDescuento > 0) {
                    const precioOferta = calcularPrecioOferta(precioOriginal, tipoDescuento, valorDescuento);
                    const descuento = tipoDescuento === 'porcentaje' ? `${valorDescuento}%` : `$${valorDescuento}`;
                    spanPreview.innerHTML = `
                        <span style="text-decoration: line-through; color: #999;">$${precioOriginal}</span>
                        <span style="color: #16784f; font-weight: bold; margin-left: 10px;">$${precioOferta}</span>
                        <span class="descuento-tag" style="margin-left: 5px;">${descuento} OFF</span>
                    `;
                } else {
                    spanPreview.textContent = '-';
                }
            });

            // Limpiar vista previa de productos no seleccionados
            document.querySelectorAll('.check-producto:not(:checked)').forEach(checkbox => {
                const productId = checkbox.value;
                const spanPreview = document.querySelector(`.precio-preview[data-id="${productId}"]`);
                spanPreview.textContent = '-';
            });
        }

        // Event listeners
        document.querySelectorAll('.check-producto').forEach(checkbox => {
            checkbox.addEventListener('change', () => {
                actualizarContador();
                actualizarVistasPrevia();
            });
        });

        document.getElementById('tipo_descuento').addEventListener('change', actualizarVistasPrevia);
        document.getElementById('valor_descuento').addEventListener('input', actualizarVistasPrevia);

        // Seleccionar todos
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.check-producto');
            checkboxes.forEach(cb => cb.checked = this.checked);
            actualizarContador();
            actualizarVistasPrevia();
        });

        function toggleTodos() {
            const selectAll = document.getElementById('selectAll');
            selectAll.checked = !selectAll.checked;
            const checkboxes = document.querySelectorAll('.check-producto');
            checkboxes.forEach(cb => cb.checked = selectAll.checked);
            actualizarContador();
            actualizarVistasPrevia();
        }

        // Validación de fechas
        document.getElementById('formOfertas').addEventListener('submit', function(e) {
            const fechaInicio = new Date(document.getElementById('fecha_inicio').value);
            const fechaFin = new Date(document.getElementById('fecha_fin').value);
            const productosSeleccionados = document.querySelectorAll('.check-producto:checked').length;

            if (productosSeleccionados === 0) {
                e.preventDefault();
                alert('Debes seleccionar al menos un producto para crear la oferta');
                return false;
            }

            if (fechaFin <= fechaInicio) {
                e.preventDefault();
                alert('La fecha de fin debe ser posterior a la fecha de inicio');
                return false;
            }

            const tipoDescuento = document.getElementById('tipo_descuento').value;
            const valorDescuento = parseFloat(document.getElementById('valor_descuento').value);

            if (tipoDescuento === 'porcentaje' && (valorDescuento <= 0 || valorDescuento > 100)) {
                e.preventDefault();
                alert('El porcentaje debe estar entre 0 y 100');
                return false;
            }
        });

        // ========= FUNCIONES DE EDICIÓN =========

        // Editar oferta específica
        function editarOfertaEspecifica(id, tipo, valor, inicio, fin) {
            document.getElementById('formEditarEspecifica').action = '/admin/ofertas/editar/' + id;
            document.getElementById('edit_esp_tipo').value = tipo;
            document.getElementById('edit_esp_valor').value = valor;
            document.getElementById('edit_esp_inicio').value = inicio;
            document.getElementById('edit_esp_fin').value = fin;
            $('#editOfertaEspecificaModal').modal('show');
        }

        // Editar oferta general
        function editarOfertaGeneral(id, nombre, descripcion, tipo, valor, inicio, fin, categoriasExcluidas) {
            document.getElementById('formEditarGeneral').action = '/admin/ofertas/general/editar/' + id;
            document.getElementById('edit_gen_nombre').value = nombre;
            document.getElementById('edit_gen_descripcion').value = descripcion;
            document.getElementById('edit_gen_tipo').value = tipo;
            document.getElementById('edit_gen_valor').value = valor;
            document.getElementById('edit_gen_inicio').value = inicio;
            document.getElementById('edit_gen_fin').value = fin;
            
            // Marcar categorías excluidas
            const excluidas = categoriasExcluidas ? categoriasExcluidas.split(',') : [];
            document.querySelectorAll('.edit-gen-cat-check').forEach(cb => {
                cb.checked = excluidas.includes(cb.value);
            });
            
            $('#editOfertaGeneralModal').modal('show');
        }
    </script>
</body>
</html>
