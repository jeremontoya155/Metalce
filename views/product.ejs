<%
// META: Helper central para limpiar textos heredados antes de mostrarlos en la ficha.
function cleanProductText(text) {
    return String(text || '')
        .replace(/�/g, 'a')
        .replace(/Â/g, 'a')
        .replace(/â€™/g, "'")
        .replace(/â€œ/g, '"')
        .replace(/â€\u009d/g, '"')
        .replace(/€™/g, "'")
        .replace(/Resolucian/gi, 'Resolucion')
        .replace(/Resolucin/gi, 'Resolucion')
        .replace(/á/g, 'a').replace(/à/g, 'a').replace(/â/g, 'a').replace(/ä/g, 'a').replace(/ã/g, 'a')
        .replace(/Á/g, 'A').replace(/À/g, 'A').replace(/Â/g, 'A').replace(/Ä/g, 'A').replace(/Ã/g, 'A')
        .replace(/é/g, 'e').replace(/è/g, 'e').replace(/ê/g, 'e').replace(/ë/g, 'e')
        .replace(/É/g, 'E').replace(/È/g, 'E').replace(/Ê/g, 'E').replace(/Ë/g, 'E')
        .replace(/í/g, 'i').replace(/ì/g, 'i').replace(/î/g, 'i').replace(/ï/g, 'i')
        .replace(/Í/g, 'I').replace(/Ì/g, 'I').replace(/Î/g, 'I').replace(/Ï/g, 'I')
        .replace(/ó/g, 'o').replace(/ò/g, 'o').replace(/ô/g, 'o').replace(/ö/g, 'o').replace(/õ/g, 'o')
        .replace(/Ó/g, 'O').replace(/Ò/g, 'O').replace(/Ô/g, 'O').replace(/Ö/g, 'O').replace(/Õ/g, 'O')
        .replace(/ú/g, 'u').replace(/ù/g, 'u').replace(/û/g, 'u').replace(/ü/g, 'u')
        .replace(/Ú/g, 'U').replace(/Ù/g, 'U').replace(/Û/g, 'U').replace(/Ü/g, 'U')
        .replace(/ñ/g, 'n').replace(/Ñ/g, 'N')
        .replace(/ç/g, 'c').replace(/Ç/g, 'C')
        .replace(/[��″"]/g, ' pulgadas')
        .replace(/pulgadas pulgadas/g, ' pulgadas')
        .replace(/\s+/g, ' ')
        .trim();
}

// META: Datos normalizados para evitar estilos inline repetidos y mantener la vista legible.
const productName = product.name || 'Producto Metal-Ce';
const productDescription = cleanProductText(product.description);
const metaDescription = productDescription || `Ficha tecnica de ${productName} en Metal-Ce S.R.L.`;
const productImage = product.img || '/imgs/logo-metalce.png';
const productCurrency = product.moneda || 'ARS';
const productSymbol = productCurrency === 'USD' ? 'USD' : '$';
const rawPrice = Number(product.price) || 0;
const offerPrice = Number(product.precio_final) || rawPrice;
const hasOffer = !!product.tiene_oferta_vigente;
const currentPrice = hasOffer ? offerPrice : rawPrice;
const savingAmount = Math.max(rawPrice - offerPrice, 0);
const categoryColor = product.categoria_color || '#8B1538';
const showConversion = typeof mostrarPrecioPesos !== 'undefined' && mostrarPrecioPesos && typeof cotizacionDolar !== 'undefined';

// META: Planes de cuotas preparados antes del render para simplificar el HTML.
let installmentPlans = [];
try { installmentPlans = JSON.parse(product.cuotas_planes || '[]'); } catch(e) { installmentPlans = []; }
if (installmentPlans.length === 0 && product.cuotas_max && product.cuotas_max > 0) {
    installmentPlans = [{ cuotas: product.cuotas_max, interes: product.interes_cuotas || 0 }];
}

let installmentBasePrice = currentPrice;
if (productCurrency === 'USD' && typeof cotizacionDolar !== 'undefined') {
    installmentBasePrice = currentPrice * cotizacionDolar;
}
%>
<!DOCTYPE html>
<html lang="es">

<head>
    <!-- META: Configuracion basica del documento -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= metaDescription.slice(0, 155) %>">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Metal-Ce S.R.L">

    <!-- META: Open Graph para que la ficha se vea mejor al compartir -->
    <meta property="og:title" content="<%= productName %> | Metal-Ce S.R.L">
    <meta property="og:description" content="<%= metaDescription.slice(0, 155) %>">
    <meta property="og:type" content="product">
    <meta property="og:image" content="<%= productImage %>">
    <meta property="og:site_name" content="Metal-Ce S.R.L">

    <!-- META: Twitter Card para previsualizacion social -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= productName %> | Metal-Ce S.R.L">
    <meta name="twitter:description" content="<%= metaDescription.slice(0, 155) %>">
    <meta name="twitter:image" content="<%= productImage %>">

    <!-- META: Titulo visible en la pestana -->
    <title><%= productName %> | Metal-Ce S.R.L</title>

    <!-- META: Estilos compartidos y estilos especificos de la ficha -->
    <link rel="stylesheet" href="/css/navBar.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/pages/productPage.css">
</head>

<body class="productPage-body">
    <!-- META: Navegacion global compartida -->
    <%- include('partials/navbarUser') %>

    <!-- META: Cabecera compacta de la ficha -->
    <header class="productPage-heroShell">
        <div class="productPage-heroContent">
            <p class="productPage-kicker">Metal-Ce S.R.L.</p>
            <h1 data-i18n="prod_title">Detalles del Producto</h1>
            <p>Ficha comercial con informacion tecnica, disponibilidad y condiciones de consulta.</p>
        </div>
    </header>

    <!-- META: Contenedor principal de la ficha premium -->
    <main class="productPage-container">
        <article class="productPage-main" aria-labelledby="product-title">
            <!-- META: Panel visual del producto -->
            <section class="productPage-mediaPanel" aria-label="Imagen del producto">
                <div class="productPage-imageFrame">
                    <% if (product.img) { %>
                        <img src="<%= productImage %>" alt="Imagen de <%= productName %>" loading="eager" decoding="async">
                    <% } else { %>
                        <div class="productPage-noImage" data-i18n="prod_no_image">Imagen no disponible</div>
                    <% } %>
                </div>

                <!-- META: Resumen rapido lateral para reforzar datos comerciales clave -->
                <div class="productPage-quickFacts">
                    <% if (product.codigo) { %>
                    <div class="productPage-fact">
                        <span data-i18n="prod_code">Código:</span>
                        <strong><%= product.codigo %></strong>
                    </div>
                    <% } %>
                    <div class="productPage-fact">
                        <span data-i18n="prod_stock">Stock:</span>
                        <strong><%= product.stock %></strong>
                    </div>
                    <% if (product.estado) { %>
                    <div class="productPage-fact">
                        <span>Estado:</span>
                        <strong><%= product.estado %></strong>
                    </div>
                    <% } %>
                </div>
            </section>

            <!-- META: Panel de informacion, precio y acciones -->
            <section class="productPage-details">
                <!-- META: Identidad del producto y categoria -->
                <div class="productPage-titleBlock">
                    <% if (product.categoria_nombre) { %>
                    <span class="productPage-categoryPill" style="--category-color: <%= categoryColor %>;">
                        <%= product.categoria_icono || '' %> <%= product.categoria_nombre %>
                    </span>
                    <% } %>
                    <h2 id="product-title" class="productPage-title"><%= productName %></h2>
                    <% if (product.codigo) { %>
                    <p class="productPage-codeLine"><span data-i18n="prod_code">Código:</span> <code><%= product.codigo %></code></p>
                    <% } %>
                </div>

                <!-- META: Bloque descriptivo principal -->
                <div class="productPage-infoCard productPage-descriptionCard">
                    <span class="productPage-sectionLabel" data-i18n="prod_description">Descripción:</span>
                    <p><%= productDescription || 'Descripcion pendiente de carga.' %></p>
                </div>

                <!-- META: Bloque de precio, oferta y conversion -->
                <div class="productPage-priceCard <%= hasOffer ? 'productPage-priceCard--offer' : '' %>">
                    <div>
                        <span class="productPage-sectionLabel"><span data-i18n="prod_price">Precio</span> (<%= productCurrency %>)</span>
                        <% if (hasOffer) { %>
                        <div class="productPage-priceRow">
                            <span class="productPage-oldPrice"><%= productSymbol %> <%= rawPrice %></span>
                            <strong class="productPage-currentPrice"><%= productSymbol %> <%= offerPrice %></strong>
                        </div>
                        <div class="productPage-offerTags">
                            <span class="productPage-saveTag"><span data-i18n="prod_save">Ahorrás</span> $<%= savingAmount.toFixed(2) %></span>
                            <% if (product.es_oferta_general && product.nombre_oferta_general) { %>
                            <span class="productPage-offerTag"><%= product.nombre_oferta_general %></span>
                            <% } else if (product.tipo_descuento === 'porcentaje') { %>
                            <span class="productPage-offerTag">-<%= product.valor_descuento %>%</span>
                            <% } %>
                        </div>
                        <% } else { %>
                        <strong class="productPage-currentPrice"><%= productSymbol %> <%= rawPrice %></strong>
                        <% } %>
                    </div>

                    <% if (showConversion) { %>
                    <!-- META: Conversion de moneda visible solo cuando el backend la habilita -->
                    <div class="productPage-conversionBox">
                        <% if (productCurrency === 'USD') { %>
                            <span>Equivale a <strong>ARS $<%= Math.round(currentPrice * cotizacionDolar).toLocaleString('es-AR') %></strong></span>
                        <% } else { %>
                            <span>Equivale a <strong>USD $<%= Math.round(currentPrice / cotizacionDolar).toLocaleString('es-AR') %></strong></span>
                        <% } %>
                        <small>Cotizacion: 1 USD = $<%= cotizacionDolar.toLocaleString('es-AR') %> ARS</small>
                    </div>
                    <% } %>
                </div>

                <% if (installmentPlans.length > 0) { %>
                <!-- META: Planes de cuotas calculados en ARS -->
                <div class="productPage-infoCard productPage-installmentsCard">
                    <div class="productPage-installmentsHeader">
                        <span class="productPage-sectionLabel" data-i18n="prod_installments_title">Opciones de cuotas</span>
                        <small data-i18n="prod_in_ars">(en ARS)</small>
                    </div>
                    <div class="productPage-installmentsList">
                        <% installmentPlans.forEach(plan => { %>
                        <%
                            const totalPlan = plan.interes > 0
                                ? (installmentBasePrice * (1 + plan.interes / 100))
                                : installmentBasePrice;
                            const monthlyValue = (totalPlan / plan.cuotas).toFixed(2);
                        %>
                        <div class="productPage-installmentItem">
                            <span><%= plan.cuotas %> <span data-i18n="prod_installments">cuotas</span></span>
                            <strong>$<%= monthlyValue %>/mes</strong>
                        </div>
                        <% }); %>
                    </div>
                </div>
                <% } %>

                <% if (product.aclaracion) { %>
                <!-- META: Aclaracion comercial importante -->
                <aside class="productPage-alertCard">
                    <strong><span data-i18n="prod_disclaimer">Aclaración:</span></strong>
                    <p><%= product.aclaracion %></p>
                </aside>
                <% } %>

                <% if (product.folleto_url) { %>
                <!-- META: Documento tecnico descargable -->
                <a href="<%= product.folleto_url %>" target="_blank" rel="noopener" class="productPage-brochureLink">
                    <span data-i18n="prod_download">Descargar folleto</span>
                </a>
                <% } %>

                <!-- META: Acciones principales de la ficha -->
                <div class="productPage-actions">
                    <% if (isAdmin) { %>
                    <a href="/edit/<%= product.id %>" class="productPage-editButton" data-i18n="prod_edit">Editar Producto</a>
                    <% } %>
                    <form action="/buy/<%= product.id %>" method="POST" class="productPage-consultForm" onclick="event.stopPropagation()">
                        <button type="submit" class="productPage-consultar" data-i18n="prod_inquire">Consultar</button>
                    </form>
                </div>
            </section>
        </article>
    </main>
</body>

</html>
